PORT=3001

# --- Opción A: Neon / Railway / Render (URL completa) ---
# Neon: Dashboard → proyecto → Connection string → copia la URI (pooler está bien).
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Si el cliente falla con channel_binding, prueba la URL sin &channel_binding=require
# DATABASE_SSL=true

# --- Opción B: Postgres local (sin DATABASE_URL) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=ventascasasmx

JWT_SECRET=cambia-esto-en-produccion-minimo-32-caracteres

# Usuarios demo (solo se crean si `users` está vacío al arrancar):
# cristobal@ventascasasmx.com / cristobal1234
# cynthia@ventascasasmx.com / cynthia1234

# En producción usa migraciones y pon false.
# Si cambias tipos de columna (p. ej. id inmueble uuid → serial), con sync=true Postgres
# puede fallar: en ese caso borra tablas afectadas o migra a mano.
TYPEORM_SYNC=true
TYPEORM_LOGGING=false

# Orígenes CORS separados por coma
# CORS_ORIGIN=https://tu-front.vercel.app,http://localhost:3000

# --- Google Cloud Storage (fotos al publicar: POST /api/inmuebles/con-fotos) ---
# 1) Consola GCP → Cloud Storage → Crear bucket (ubicación y nombre a tu gusto).
# 2) Para URLs públicas: en el bucket → Permisos → otorgar acceso público de lectura
#    a objetos (o deja el código intentar makePublic() y ajusta IAM si falla).
# 3) IAM → Cuentas de servicio → Crear → rol "Administrador de objetos de Storage"
#    (o "Storage Object Admin") → Claves → JSON.
# Obligatorio: nombre del bucket + credenciales (elige UNA de las dos formas):
# GCS_BUCKET=nombre-del-bucket
# Forma A — JSON en una sola línea (útil en Railway/Render; escapa comillas si hace falta):
# GCS_CREDENTIALS_JSON={"type":"service_account","project_id":"...",...}
# Forma B — ruta al archivo JSON en el servidor (local o VM):
# GOOGLE_APPLICATION_CREDENTIALS=C:\ruta\a\clave-servicio.json
# Opcional: base pública si usas CDN o dominio personalizado (sin barra final):
# GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/nombre-del-bucket
