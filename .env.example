PORT=3001

# --- Opción A: Neon / Railway / Render (URL completa) ---
# Neon: Dashboard → proyecto → Connection string → copia la URI (pooler está bien).
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Si el cliente falla con channel_binding, prueba la URL sin &channel_binding=require
# DATABASE_SSL=true

# --- Opción B: Postgres local (sin DATABASE_URL) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=ventascasasmx

JWT_SECRET=cambia-esto-en-produccion-minimo-32-caracteres

# Usuarios demo (solo se crean si `users` está vacío al arrancar):
# cristobal@ventascasasmx.com / cristobal1234
# cynthia@ventascasasmx.com / cynthia1234

# En producción usa migraciones y pon false
TYPEORM_SYNC=true
TYPEORM_LOGGING=false

# Orígenes CORS separados por coma
# CORS_ORIGIN=https://tu-front.vercel.app,http://localhost:3000
